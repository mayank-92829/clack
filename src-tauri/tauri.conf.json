{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clack",
  "mainBinaryName": "Clack",
  "version": "1.0.0",
  "identifier": "com.clack.typing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clack",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1b1d22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Clack",
    "category": "Utility",
    "shortDescription": "An offline, minimalist typing test",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
